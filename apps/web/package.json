    "write-excel-file": "4.1.1",
    "react-data-grid": "7.0.0-beta.64"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsbarcode": "3.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
